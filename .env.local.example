# RPC endpoints (server-side only)
BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Recipient wallets (the seller/platform receiving USDC)
BASE_RECIPIENT_ADDRESS=0x...
SOLANA_RECIPIENT_ADDRESS=...base58...
ICP_RECIPIENT_PRINCIPAL=...principal-text...

# Client-side recipient addresses (for wallet UI)
NEXT_PUBLIC_BASE_RECIPIENT=0x...
NEXT_PUBLIC_SOLANA_RECIPIENT=...base58...
NEXT_PUBLIC_ICP_RECIPIENT=...principal-text...

# Client-side Solana RPC (optional)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Ollama fallback URL for local LLM
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# Aegis Bridge (connect to Aegis本体 D2A API)
AEGIS_BRIDGE_ENABLED=false
AEGIS_HONTAL_URL=https://aegis.dwebxr.xyz
# IC principal for individual briefings (required — without this, only global summary is available)
AEGIS_BRIDGE_PRINCIPAL=
AEGIS_SYNC_INTERVAL_MS=300000
AEGIS_AGENT_ID=aegis-hontal
AEGIS_DEFAULT_CHAINS=base,solana,icp
AEGIS_PRICE_TIER_MAP={"free":0,"basic":2,"premium":10}
AEGIS_MIN_COMPOSITE_SCORE=7.0
AEGIS_BRIDGE_QUALITY_ONLY=true
